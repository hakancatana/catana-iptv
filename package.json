{
  "name": "catana-iptv",
  "productName": "Catana IPTV",
  "version": "1.6.1",
  "description": "Catana IPTV — Xtream Codes desktop player",
  "main": "main.js",
  "author": {
    "name": "Mustafa Hakan Çatana",
    "email": "hakancatana@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux AppImage deb rpm",
    "test": "playwright test"
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "mpegts.js": "^1.8.2"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "@playwright/test": "^1.65.0"
  },
  "build": {
    "appId": "com.catana.iptv",
    "productName": "Catana IPTV",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json",
      "node_modules/hls.js/dist/hls.min.js",
      "node_modules/mpegts.js/dist/mpegts.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Catana IPTV",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Catana-IPTV-Setup-${version}.exe",
      "language": "1055",
      "multiLanguageInstaller": false
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hakancatana",
        "repo": "catana-iptv",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Catana-IPTV-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "build/icons",
      "category": "AudioVideo",
      "executableName": "catana-iptv",
      "synopsis": "Desktop IPTV player for Xtream Codes",
      "description": "Catana IPTV is a modern desktop player for Xtream Codes IPTV with live TV, TV guide, movies and series.",
      "maintainer": "Mustafa Hakan Çatana <hakancatana@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "Name": "Catana IPTV",
          "StartupWMClass": "Catana IPTV",
          "Keywords": "iptv;tv;xtream;video;"
        }
      }
    },
    "appImage": {
      "artifactName": "Catana-IPTV-${version}-x86_64.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hakancatana/catana-iptv.git"
  },
  "homepage": "https://github.com/hakancatana/catana-iptv"
}